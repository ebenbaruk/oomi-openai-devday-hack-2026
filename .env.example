# Server only. Copy to .env.local. Never add NEXT_PUBLIC_ to these values.
OPENAI_API_KEY=
# Supabase (org Oomi, projet oomi, region eu-west-3). Runtime = pooler transaction (6543), migrations = pooler session (5432).
# Local Docker alternative: postgresql://oomi:local-development-only@localhost:5432/oomi
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-eu-west-3.pooler.supabase.com:6543/postgres?sslmode=no-verify
DATABASE_URL_MIGRATE=postgresql://postgres.<project-ref>:<db-password>@aws-1-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=no-verify

# Required for live sessions, even locally. Use long random values.
OOMI_ACCESS_CODE=
OOMI_SESSION_SECRET=
APP_ORIGIN=http://localhost:3000

OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_DECISION_MODEL=gpt-6-luna
OPENAI_BRAIN_MODEL=gpt-6.1-sol
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Turn-by-turn path (Apple Watch, ESP32): file transcription + text-to-speech. gpt-4o-mini-tts is deprecated (shutdown Jan 2027), replace before then.
OPENAI_FILE_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Adult-operated hackathon profile. No real child data.
OOMI_LANGUAGE=en
OOMI_CHILD_AGE=7
OOMI_SESSION_SECONDS=240
OOMI_SAFETY_TIMEOUT_MS=4000
