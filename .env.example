# OpenAI
OPENAI_API_KEY=

# Postgres (Supabase pooler). Transaction pooler for the app, session pooler for migrations.
DATABASE_URL=
DATABASE_URL_MIGRATE=

# Shared access code that unlocks the app, and the secret used to sign the access cookie
OOMI_ACCESS_CODE=
OOMI_SESSION_SECRET=

# Optional model overrides (defaults in src/server/env.ts)
# OOMI_MODEL_REALTIME=gpt-realtime-2.1
# OOMI_MODEL_TRANSCRIBE=gpt-live-transcribe
# OOMI_MODEL_TRANSCRIBE_FILE=gpt-transcribe
# OOMI_MODEL_BRAIN=gpt-6-luna
# OOMI_MODEL_FAST=gpt-5.4-nano
# OOMI_MODEL_IMAGE=gpt-image-2
# OOMI_MODEL_TTS=gpt-4o-mini-tts
# OOMI_VOICE=marin
